{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ieaas-global-manager",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "not_found_handling": "single-page-application"
  }
}
